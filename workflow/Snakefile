# Snakemake Pipeline — scRNA-seq

import pandas as pd
import os

# Config
configfile: "config/config.yaml"

# Sample sheet
SAMPLE_SHEET = pd.read_csv(config["input"]["samples"], sep=None, engine="python")
SAMPLE_PATHS = dict(zip(SAMPLE_SHEET.iloc[:, 0].astype(str), SAMPLE_SHEET.iloc[:, 1].astype(str)))
SAMPLES = list(SAMPLE_PATHS.keys())

# Output directories
SOUPX_DIR         = config["output"]["soupx_dir"]
QC_PRE_DIR        = config["output"]["qc_pre_dir"]
MULTIQC_PRE_DIR   = config["output"]["multiqc_pre_dir"]
MULTIQC_POST_DIR  = config["output"]["multiqc_post_dir"]
FILT_DIR          = config["output"]["filtered_dir"]
QC_POST_DIR       = config["output"]["qc_post_dir"]
MERGE_DIR         = config["output"]["merge_dir"]
FACS_DIR          = config["output"]["facs_dir"]
HARMONY_DIR       = config["output"]["harmony_dir"]
CLUSTERING_DIR    = config["output"]["clustering_dir"]
CELLTYPIST_DIR    = config["output"]["celltypist_dir"]
USE_SOUPX      = config["soupx"]["use_soupx"]
RUN_HARMONY    = config["harmony"]["run_harmony"]

# define celltypist model with defaults for gut per species

CELLTYPIST_MODEL = (
    config["celltypist"].get("model")
    or {"mouse": "Adult_Mouse_Gut", "human":
"Cells_Intestinal_Tract"}[config["species"]]
)

# Helper functions

def sample_h5(wildcards):
    """Resolve raw count matrix path for a sample."""
    return SAMPLE_PATHS[wildcards.sample]

def qc_input(wildcards):
    """
    Resolve the count matrix fed into QC / filtering:
    - SoupX-corrected .h5ad if use_soupx: true in config
    - Raw matrix from sample sheet otherwise
    """
    if USE_SOUPX:
        return os.path.join(SOUPX_DIR, "files", f"{wildcards.sample}.h5ad")
    return sample_h5(wildcards)


def clustering_input(wildcards):
    """
    Resolve the clustering input:
    - Harmony-integrated .h5ad if use_harmony: true in config
    - Merged object otherwise
    """
    if config["clustering"]["use_harmony"]:
        return os.path.join(HARMONY_DIR, "files", "sc.h5ad")
    return os.path.join(FACS_DIR, "files", "sc.h5ad")


# Include rules
include: "rules/01_soupx.smk"
include: "rules/02_qc_pre.smk"
include: "rules/03_multiqc_pre.smk"
include: "rules/04_multiqc_post.smk"
include: "rules/05_filtering.smk"
include: "rules/06_qc_post.smk"
include: "rules/07_merge.smk"
include: "rules/08_remove_facs_contamination.smk"
include: "rules/09_harmony.smk"
include: "rules/10_clustering.smk"
include: "rules/11_celltypist.smk"


# Target rule
rule all:
    input:
        # Per-sample pre-filtering QC
        expand(os.path.join(QC_PRE_DIR, "files", "pre_{sample}_qc.html"),             sample=SAMPLES),
        expand(os.path.join(QC_PRE_DIR, "files", "pre_{sample}_cell_qc_metrics.csv"), sample=SAMPLES),
        # Cohort pre-filtering report
        os.path.join(MULTIQC_PRE_DIR, "files", "pre_cohort_qc_report.html"),
        os.path.join(MULTIQC_PRE_DIR, "files", "pre_cohort_qc_metrics.csv"),
        # Filtered data
        expand(os.path.join(FILT_DIR, "files", "{sample}_filtered.h5ad"),             sample=SAMPLES),
        # Per-sample post-filtering QC
        expand(os.path.join(QC_POST_DIR, "files", "post_{sample}_qc.html"),           sample=SAMPLES),
        expand(os.path.join(QC_POST_DIR, "files", "post_{sample}_cell_qc_metrics.csv"),sample=SAMPLES),
        # Cohort post-filtering report
        os.path.join(MULTIQC_POST_DIR, "files", "post_cohort_qc_report.html"),
        os.path.join(MULTIQC_POST_DIR, "files", "post_cohort_qc_metrics.csv"),
        # SoupX (only produced when use_soupx: true)
        expand(os.path.join(SOUPX_DIR, "files", "{sample}.h5ad"),           sample=SAMPLES),
        # Final merged object
        os.path.join(MERGE_DIR, "files", "sc.h5ad"),
        os.path.join(FACS_DIR, "files", "sc.h5ad"),
        *([os.path.join(HARMONY_DIR, "files", "sc.h5ad"),
           os.path.join(HARMONY_DIR, "figures", "sc_harmony.pdf")] if RUN_HARMONY else []),
        os.path.join(CLUSTERING_DIR, "files", "sc.h5ad"),
        os.path.join(CELLTYPIST_DIR, "files", "sc.h5ad"),
        os.path.join(FACS_DIR, "files", "sc.h5ad")
