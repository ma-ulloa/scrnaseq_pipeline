# Snakemake Pipeline — scRNA-seq
# ══════════════════════════════════════════════════════════════════════════════
import pandas as pd
import os

# ── Config ────────────────────────────────────────────────────────────────────
configfile: "config/config.yaml"

# ── Sample sheet ──────────────────────────────────────────────────────────────
SAMPLE_SHEET = pd.read_csv(config["input"]["sample_sheet"], sep=None, engine="python")
SAMPLE_PATHS = dict(zip(
    SAMPLE_SHEET.iloc[:, 0].astype(str),
    SAMPLE_SHEET.iloc[:, 1].astype(str),
))
SAMPLES = list(SAMPLE_PATHS.keys())

# ── Output directories ────────────────────────────────────────────────────────
QC_DIR    = config["output"]["qc_dir"]
FILT_DIR  = config["output"]["filtered_dir"]
SOUPX_DIR = config["output"]["soupx_dir"]
MERGE_DIR = config["output"]["merge_dir"]
USE_SOUPX = config["soupx"]["use_soupx"]

# ── Helper functions ──────────────────────────────────────────────────────────
def sample_h5(wildcards):
    """Resolve raw count matrix path for a sample."""
    return SAMPLE_PATHS[wildcards.sample]

def qc_input(wildcards):
    """
    Resolve the count matrix fed into QC / filtering:
    - SoupX-corrected .h5ad if use_soupx: true in config
    - Raw matrix from sample sheet otherwise
    """
    if USE_SOUPX:
        return os.path.join(SOUPX_DIR, f"{wildcards.sample}.h5ad")
    return sample_h5(wildcards)

# ── Include rules ─────────────────────────────────────────────────────────────
include: "rules/soupx.smk"
include: "rules/qc_pre.smk"          
include: "rules/multiqc_pre.smk"
include: "rules/multiqc_post.smk"   
include: "rules/filtering.smk"        
include: "rules/qc_post.smk"          
include: "rules/merge.smk"

# ── Target rule ───────────────────────────────────────────────────────────────
rule all:
    input:
        # Per-sample pre-filtering QC
        expand(os.path.join(QC_DIR, "pre_{sample}_qc.html"),             sample=SAMPLES),
        expand(os.path.join(QC_DIR, "pre_{sample}_cell_qc_metrics.csv"), sample=SAMPLES),
        # Cohort pre-filtering report
        os.path.join(QC_DIR, "pre_cohort_qc_report.html"),
        os.path.join(QC_DIR, "pre_cohort_qc_metrics.csv"),
        # Filtered data
        expand(os.path.join(FILT_DIR, "{sample}_filtered.h5ad"),         sample=SAMPLES),
        # Per-sample post-filtering QC
        expand(os.path.join(QC_DIR, "post_{sample}_qc.html"),            sample=SAMPLES),
        expand(os.path.join(QC_DIR, "post_{sample}_cell_qc_metrics.csv"),sample=SAMPLES),
        # Cohort post-filtering report
        os.path.join(QC_DIR, "post_cohort_qc_report.html"),
        os.path.join(QC_DIR, "post_cohort_qc_metrics.csv"),
        # SoupX (only produced when use_soupx: true)
        expand(os.path.join(SOUPX_DIR, "{sample}.h5ad"),                 sample=SAMPLES),
        # Final merged object
        os.path.join(MERGE_DIR, "sc.h5ad"),
