import pandas as pd
import os

# Point to config file :). This creates a dictionary 
configfile: "config/config.yaml"

# Samples from metadata (first column, regardless of name column) 
METADATA   = pd.read_csv(config["input"]["metadata"])
# Gets sample names from metadata first column
SAMPLES    = METADATA.iloc[:, 0].astype(str).tolist() # This list is call later in the general rule
DATA_DIR   = config["input"]["data_dir"]
H5_FILE    = config["input"]["h5_filename"]
QC_DIR     = config["output"]["qc_dir"]
FILT_DIR   = config["output"]["filtered_dir"]

def sample_h5(wildcards):
    """Get .h5 path for a given sample wildcard."""
    return os.path.join(DATA_DIR, f"{wildcards.sample}_features", H5_FILE)
